# Alpaca AI Trading Agents Hackathon — env var reference
# Copy to .env.local and fill in real values there. Never commit real keys.

# Alpaca paper trading (dev/backtest account — Phase 0/1)
ALPACA_API_KEY=your_dev_paper_api_key
ALPACA_SECRET_KEY=your_dev_paper_secret_key

# Featherless AI (LLM provider — OpenAI-compatible API)
FEATHERLESS_API_KEY=your_featherless_api_key

# --- Filled in later, during Phase 2 ---
# Fresh dedicated Alpaca paper account created for the judged submission.
# Must be a DIFFERENT account from the dev one above.
ALPACA_SUBMISSION_API_KEY=your_submission_paper_api_key
ALPACA_SUBMISSION_SECRET_KEY=your_submission_paper_secret_key
ALPACA_SUBMISSION_ACCOUNT_ID=your_submission_account_id

# --- Optional, only if the hybrid/GEX strategy candidate needs it (Phase 1) ---
FRED_API_KEY=your_fred_api_key
